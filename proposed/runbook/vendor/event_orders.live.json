  "constraints": [
    {
      "name": "event_orders_event_id_fkey",
      "type": "f",
      "def": "FOREIGN KEY (event_id) REFERENCES events(id) ON DELETE CASCADE"
    },
    {
      "name": "event_orders_pkey",
      "type": "p",
      "def": "PRIMARY KEY (id)"
    },
    {
      "name": "event_orders_status_check",
      "type": "c",
      "def": "CHECK ((status = ANY (ARRAY['pending'::text, 'paid'::text, 'checked_in'::text, 'refunded'::text, 'cancelled'::text])))"
    },
    {
      "name": "event_orders_tier_id_fkey",
      "type": "f",
      "def": "FOREIGN KEY (tier_id) REFERENCES ticket_tiers(id) ON DELETE SET NULL"
    }
  ],
  "indexes": [
    "CREATE UNIQUE INDEX event_orders_pkey ON public.event_orders USING btree (id)",
    "CREATE INDEX event_orders_qr_token_idx ON public.event_orders USING btree (qr_token)",
    "CREATE UNIQUE INDEX event_orders_session_tier_uidx ON public.event_orders USING btree (stripe_session_id, tier_id) WHERE (stripe_session_id IS NOT NULL)",
    "CREATE INDEX orders_event_idx ON public.event_orders USING btree (event_id, status)"
  ],
  "rls": {
    "enabled": true,
    "forced": false
  },
  "policies": [
